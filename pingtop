        hits.append((row, x + 2, 1, box_width - 4, "snmp_field", index))
    result_y = y + capacity + 2
    page = y + box_height - 2 - result_y
    lines = ["Consultando SNMP…", *output] if busy else output or ["Preencha os campos e pressione Enter."]
    lines = [part for line in lines for part in (textwrap.wrap(line, box_width - 4) or [""])]
