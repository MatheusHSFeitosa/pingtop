def visible_targets(monitors, query, state, reverse):
    query = query.casefold()
    status = (None, "OK", "TIMEOUT")[state]
    indices = [
        index for index, monitor in enumerate(monitors)
        if (status is None or monitor.status == status)
        and any(query in name.casefold() for name in (monitor.host, monitor.address or "", monitor.group or ""))
    ]
    groups = {}
    for index in indices:
        groups.setdefault(monitors[index].group or index, []).append(index)
    ordered = list(groups.values())
    if reverse:
        ordered.reverse()
    return [index for group in ordered for index in group]


def target_tree(monitors, show_headers):
    rows = []
    for index, monitor in enumerate(monitors):
        group = monitor.group
        if group and show_headers and (index == 0 or monitors[index - 1].group != group):
            rows.append((None, group))
        label = monitor.host
        if group:
            branch = "├─" if index + 1 < len(monitors) and monitors[index + 1].group == group else "└─"
            label = f"{branch} {label}" if show_headers else f"{label} · {group}"
        rows.append((index, label))
    return rows


def loss_meter(lost, sent, segments):
    if not sent or not lost:
        return 0
    if lost == sent:
        return segments
    return max(1, min(segments - 1, (lost * segments + sent // 2) // sent))


def loss_segments(width):
    return 8 if width >= 64 else (5 if width >= 51 else 0)


def draw_loss_meter(put, row, x, monitor, segments, muted, warning, critical, selection):
    filled = loss_meter(monitor.lost, monitor.sent, segments) if segments else 0
    if filled:
        color = critical if monitor.lost == monitor.sent else warning
        put(row, x, "▪" * filled, color | selection)
    if filled < segments:
        put(row, x + filled, "▪" * (segments - filled), muted | curses.A_DIM | selection)


