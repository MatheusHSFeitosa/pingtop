        border_label(put, 0, 25, family, cyan, hotkey=True, active=bool(versions))
        hit(0, 25, len(family) + 2, "key", ord("v"))
    timing = f"{time.strftime('%H:%M:%S')}  ·  {interval:g} s"
    put(1, width - len(timing) - 2, timing, cyan)
    wide = width >= 95 and height >= 20
    details_width = width * 3 // 10
    table_x = details_width + 1 if wide else 0
    table_width = width - table_x
    chart_width = min(width * 3 // 5, width - 40) if wide else width
    route_x = chart_width + 1 if wide else 0
    route_width = width - route_x
    split = max(6, (height - 8) // 3) if wide else 0
    chart_y = 3 + split + int(wide)
    chart_height = height - chart_y - 4 if wide else max(6, (height - 6) // 2)
    route_y = chart_y if wide else chart_y + chart_height
    table_y = 3 if wide else route_y
    table_height = split if wide else height - table_y - 3
    route_height = chart_height if wide else table_height
    target = monitors[selected] if monitors else None
    current_hop = hops[hop_index][1] if hops else None
    chart = current_hop if route_focus and current_hop else target

    if wide:
        panel(put, 3, 0, split, details_width, "1 Alvo selecionado", purple)
        if target:
            last = target.history[-1] if target.history else None
            rtt = f"{last:.2f} ms" if last is not None else "—"
            loss = f"{target.lost / target.sent:.1%}" if target.sent else "—"
            lines = (
                (f"ALVO    {target.host}", bold),
                (f"ESTADO  {target.status}   RTT {rtt}", green if target.status == "OK" else yellow),
                (f"PERDA   {loss} ({target.lost}/{target.sent})", 0),
                (f"ENVIOS  {target.sent}   RECEB. {target.sent - target.lost}", 0),
                (f"PING    {target.stamp}", 0),
            )
            details = list(lines)
            if route_focus and current_hop:
                for index, (name, address, rtt) in enumerate(current_hop.route_probes, 1):
                    response = "*" if rtt is None else f"{address} {rtt:.3f} ms"
                    if name and name != address:
                        response += f" · {name}"
                    details.append((f"Sonda {index}  {response}", purple))
            for row, (line, style) in enumerate(details[:split - 2], 4):
                put(row, 2, line[:details_width - 4], style)
    title = f"3 Gráfico / salto {hops[hop_index][0]}" if route_focus and current_hop else "3 Gráfico / alvo"
    if chart:
        title += f" · {chart.address or chart.host}"
    panel(put, chart_y, 0, chart_height, chart_width, title, purple)
    if chart:
        draw_graph(put, chart_y, chart_width, chart_height, chart, green, red, purple, graph_mode, shaded_history)
    else:
        put(chart_y + 1, 2, "Nenhum alvo neste filtro." if total else "Pressione a para adicionar um alvo.", yellow)

    if wide or not route_focus:
        hit(table_y, table_x, table_width, "targets", height=table_height)
        panel(put, table_y, table_x, table_height, table_width, "2 Alvos monitorados",
              cyan | (0 if route_focus else bold))
        border_label(put, table_y, table_x + 23, "filtro", cyan, hotkey=True, active=bool(query))
        border_label(put, table_y, table_x + 32, "reverter", cyan, hotkey=True, active=reverse)
        hit(table_y, table_x + 23, 8, "key", ord("f"))
        hit(table_y, table_x + 32, 10, "key", ord("r"))
        border_label(put, table_y + table_height - 1, table_x + 2,
                     f"status: {TARGET_STATES[target_state]}", cyan,
                     bottom=True, hotkey=True, active=target_state != 0)
        hit(table_y + table_height - 1, table_x + 2, 10 + len(TARGET_STATES[target_state]), "key", ord("s"))
        position = f" {selected + 1 if monitors else 0}/{len(monitors)} "
        border_label(put, table_y + table_height - 1, table_x + table_width - len(position) - 3, position, cyan, bottom=True)
        segments = loss_segments(table_width)
        meter_width = segments + bool(segments)
        name_width = table_width - 31 - meter_width
        put(table_y + 1, table_x + 2,
            f"{'ALVO':<{name_width}} {'ESTADO':<8} {'RTT':>9} {'PERDA':>{6 + meter_width}}", bold)
        visible = table_height - 3
        rows = target_tree(monitors, visible > 1)
        selected_row = next((row for row, (index, _) in enumerate(rows) if index == selected), 0)
        start = max(0, selected_row - visible + 1)
        for row, (index, label) in enumerate(rows[start:start + visible], table_y + 2):
            if index is None:
                put(row, table_x + 2, label[:name_width], cyan | bold)
                continue
            monitor = monitors[index]
            hit(row, table_x + 1, table_width - 2, "target", index)
            style = {"OK": green, "AGUARDE": yellow}.get(monitor.status, red)
            if index == selected:
                style |= curses.A_REVERSE
            last = monitor.history[-1] if monitor.history else None
            latency = f"{last:.2f} ms" if last is not None else "—"
            loss = f"{monitor.lost / monitor.sent:.0%}" if monitor.sent else "—"
            prefix = f"{label[:name_width]:<{name_width}} {monitor.status:<8} {latency:>9} "
            put(row, table_x + 2, prefix + " " * meter_width + f"{loss:>6}", style)
            draw_loss_meter(put, row, table_x + 2 + len(prefix), monitor, segments,
                            purple, yellow, red, style & curses.A_REVERSE)

    if wide or route_focus:
        hit(route_y, route_x, route_width, "hops", height=route_height)
        panel(put, route_y, route_x, route_height, route_width, "4 Tracert / ICMP", red)
        route_action = " t parar " if route_enabled else " t iniciar "
        border_label(put, route_y + route_height - 1, route_x + route_width - len(route_action) - 3, route_action, red, bottom=True)
        hit(route_y + route_height - 1, route_x + route_width - len(route_action) - 3,
            len(route_action) + 2, "key", ord("t"))
        if hops:
            position = f" {hop_index + 1}/{len(hops)} "
            border_label(put, route_y + route_height - 1, route_x + 2, position, red, bottom=True)
        segments = loss_segments(route_width)
        rtt_width = 7 if route_width >= 59 else 5
        name_width = route_width - 15 - 3 * rtt_width - (segments + 1 if segments else 0)
        rtt_headings = (f"RTT{n}" + (" ms" if rtt_width == 7 else "") for n in range(1, 4))
        headings = " ".join(f"{label:>{rtt_width}}" for label in rtt_headings)
        loss_width = 5 + segments + bool(segments)
        put(route_y + 1, route_x + 2,
            f"{'Nº':>2} {'HOST / IP':<{name_width}} {headings} {'Perda':>{loss_width}}", bold)
        visible_hops = route_height - 3 - bool(hops and route_message)
        start = max(0, hop_index - visible_hops + 1)
        for index, (ttl, hop) in enumerate(hops[start:start + visible_hops], start):
            times = [f"{value:.{2 if rtt_width == 7 or value < 100 else 1}f}" if value is not None else "*"
                     for _, _, value in hop.route_probes]
            times.extend(["—"] * (3 - len(times)))
            style = green if any(value is not None for _, _, value in hop.route_probes) else yellow
            if route_focus and index == hop_index:
                style |= curses.A_REVERSE
            label = hop.route_names
            if len(label) > name_width and hop.address:
                label = hop.address + (" +" if "," in hop.route_names else "")
            loss = f"{hop.lost / hop.sent:.0%}" if hop.sent else "—"
            rtts = " ".join(f"{value:>{rtt_width}}" for value in times)
            row = route_y + 2 + index - start
            hit(row, route_x + 1, route_width - 2, "hop", index)
            prefix = f"{ttl:2} {label[:name_width]:<{name_width}} {rtts} "
            put(row, route_x + 2, prefix + " " * (loss_width - 5) + f"{loss:>5}", style)
            draw_loss_meter(put, row, route_x + 2 + len(prefix), hop, segments,
                            purple, yellow, red, style & curses.A_REVERSE)
        if not hops or route_message:
            put(route_y + route_height - 2, route_x + 2,
                (route_message or "t Iniciar rota")[:route_width - 4], yellow)

    put(height - 2, 2, message, yellow)
    actions = (
        ("p", ("Pausar" if ping_enabled else "Retomar") if wide else "Ping"),
        ("t", "Rota"),
        ("Tab", "Foco"),
        ("a", "Adic." if wide else "+"),
        ("d", "Rem." if wide else "−"),
        ("n", "DNS"),
        ("q", "Sair"),
    )
    x = 1
    for key, action in actions:
        put(height - 1, x, key, cyan | bold)
        put(height - 1, x + len(key) + 1, action, curses.A_DIM)
        hit(height - 1, x, len(key) + len(action) + 1, "key", 9 if key == "Tab" else ord(key))
        x += len(key) + len(action) + 3
    return max(1, visible_hops if route_focus else table_height - 3)


def dashboard(screen, hosts, interval, versions=()):
    curses.curs_set(0)
    screen.keypad(True)
    curses.set_escdelay(35)
    screen.timeout(150)
    wheel_up = getattr(curses, "BUTTON4_PRESSED", 0)
    wheel_down = getattr(curses, "BUTTON5_PRESSED", 0)
    click = curses.BUTTON1_PRESSED
    curses.mousemask(click | wheel_up | wheel_down)
    curses.mouseinterval(0)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()

    theme_background = True
    backgrounds = {"Discreto": 233, "Drácula": 236, "Nord": 237, "Gruvbox": 235, "Terminal": 0}

    shaded_history = False

    def apply_theme(theme):
        nonlocal shaded_history
        if not curses.has_colors():
            return
        colors = (curses.COLOR_CYAN, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                  curses.COLOR_RED, curses.COLOR_MAGENTA)
        palette, gradient = THEMES[theme]
        background = -1
        if theme_background:
            background = backgrounds[theme] if curses.COLORS >= 256 else curses.COLOR_BLACK
        shaded_history = theme_background and curses.COLORS >= 256 and curses.COLOR_PAIRS >= 23
        if shaded_history:
            for index, color in enumerate(HISTORY_GREYS, 15):
                curses.init_pair(index, max(color, background + 8), background)
        curses.init_pair(14, curses.COLOR_WHITE if theme_background else -1, background)
        screen.bkgdset(" ", curses.color_pair(14))
        if curses.COLORS >= 256 and palette:
            colors = palette
        for index, color in enumerate(colors, 1):
            curses.init_pair(index, color, background)
        if curses.COLORS >= 256:
            for index, color in enumerate(gradient or (curses.COLOR_GREEN,) * 4, 6):
                curses.init_pair(index, color, background)
            reverse_gradient = (218, 176, 133, 90) if palette else (curses.COLOR_MAGENTA,) * 4
            for index, color in enumerate(reverse_gradient, 10):
                curses.init_pair(index, color, background)

    graph_mode = "Micro"
    theme = next(iter(THEMES))
    apply_theme(theme)

    monitors = [Monitor(host, group=group) for host, group in hosts]
    selected = 0
    query = ""
    filter_edit = None
    lookup_query = lookup_pending = None
    lookup_output = []
    lookup_offset = 0
    target_state = 0
    reverse = False
    next_probe = 0
    ping_enabled = True
    message = ""
    menu = None
    menu_index = 0
    route_enabled = route_focus = False
    route_target = route_pending = None
    route_generation = 0
    route_message = ""
    next_trace = 0
    hops = []
    hop_index = 0
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool, ThreadPoolExecutor(max_workers=1) as routes, ThreadPoolExecutor(max_workers=1) as dns:
        while True:
            now = time.monotonic()
            if now >= next_probe:
                for monitor in monitors:
                    monitor.update(pool, ping_enabled)
                next_probe = now + interval

            indices = visible_targets(monitors, query, target_state, reverse)
            if indices and selected not in indices:
                selected = indices[0]
            target = monitors[selected] if indices and route_enabled else None
            if target is not route_target:
                route_target = target
                route_generation += 1
                hops = []
                hop_index = 0
                next_trace = 0
                route_message = "Sondando rota…" if target else ""
            if route_pending and route_pending[1].done():
                generation, future = route_pending
                route_pending = None
                if generation == route_generation:
                    results, route_message = future.result()
                    previous = dict(hops)
                    if results:
                        hops = []
                        for ttl, probes, stamp in results:
                            old = previous.get(ttl)
                            address = next((ip for _, ip, _ in probes if ip), None)
                            label = address or (old.host if old else "*")
                            hop = old if old and old.host == label else Monitor(label)
                            hop.route_probes = probes
                            labels = dict.fromkeys(
                                f"{name} ({ip})" if name != ip else ip
                                for name, ip, _ in probes if ip
                            )
                            hop.route_names = ", ".join(labels) or "*"
                            for _, ip, rtt in probes:
                                hop.record("OK" if rtt is not None else "TIMEOUT", rtt, address, stamp)
                            hops.append((ttl, hop))
                        hop_index = min(hop_index, len(hops) - 1)
                    next_trace = now + max(1, interval)
            if target and route_pending is None and now >= next_trace:
                route_pending = (route_generation, routes.submit(trace, target.address or target.host))

            if lookup_pending is not None and lookup_pending.done():
                lookup_output = lookup_pending.result()
                lookup_pending = None
                lookup_offset = 0

            screen.erase()
            height, width = screen.getmaxyx()

            def put(y, x, value, style=0):
                if 0 <= y < height and 0 <= x < width - 1:
                    if curses.has_colors() and not style & curses.A_COLOR:
                        style |= curses.color_pair(14)
                    screen.addnstr(y, x, value, width - x - 1, style)

            if width < 48 or height < 16:
                menu = None

            def background(y, x, value, style=0):
                put(y, x, value, curses.A_DIM if menu or lookup_query is not None else style)

            view_message = message
            if filter_edit is not None:
                view_message = f"Filtro: {query}▏"
            elif query:
                view_message = f"{message}  ·  Filtro: {query}" if message else f"Filtro: {query}"
            view_index = indices.index(selected) if indices else 0
            hits = []
            page = draw_dashboard(background, height, width, [monitors[i] for i in indices],
                                  view_index, interval, view_message, hops, hop_index, route_focus,
                                  route_message, route_enabled, ping_enabled, graph_mode,
                                  query, target_state, reverse, len(monitors), shaded_history, versions, hits)
            if menu:
                hits.clear()
                draw_menu(put, height, width, menu, menu_index, interval, theme, graph_mode, theme_background, hits)
            if lookup_query is not None:
                hits.clear()
                lookup_page = draw_lookup(put, height, width, lookup_query, lookup_output,
                                          lookup_offset, lookup_pending is not None)
            try:
                key = screen.getch()
            except KeyboardInterrupt:
                filter_edit = lookup_query = None
                key = ord("q")
            if lookup_query is not None:
                if key == 27:
                    lookup_query = None
                elif key in (10, 13, curses.KEY_ENTER) and lookup_pending is None:
                    lookup_offset = 0
                    lookup_pending = dns.submit(dns_lookup, lookup_query.strip())
                elif key in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE):
                    delta = {curses.KEY_UP: -1, curses.KEY_DOWN: 1,
                             curses.KEY_PPAGE: -lookup_page, curses.KEY_NPAGE: lookup_page}[key]
                    lookup_offset = max(0, min(len(lookup_output) - lookup_page, lookup_offset + delta))
                elif key in (8, 127, curses.KEY_BACKSPACE):
                    lookup_query = lookup_query[:-1]
                elif key == curses.KEY_DC:
                    lookup_query = ""
                elif 32 <= key <= 126 and len(lookup_query) < 253:
                    lookup_query += chr(key)
                elif key == curses.KEY_MOUSE:
                    try:
                        curses.getmouse()
                    except curses.error:
                        pass
                continue
            if key == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, buttons = curses.getmouse()
                except curses.error:
                    continue
                if filter_edit is not None:
                    continue
                matches = [
                    (kind, value) for y, x, rows, cols, kind, value in reversed(hits)
                    if y <= my < y + rows and x <= mx < x + cols
                ]
                if not matches:
                    continue
                if buttons & (wheel_up | wheel_down):
                    panel_kind = next((kind for kind, _ in matches if kind in ("targets", "hops")), None)
                    if panel_kind is None:
                        continue
                    route_focus = panel_kind == "hops" and route_enabled
                    if panel_kind == "hops" and not route_focus:
                        continue
                    key = curses.KEY_UP if buttons & wheel_up else curses.KEY_DOWN
                elif buttons & click:
                    kind, value = matches[0]
                    if kind == "target":
                        selected, route_focus = indices[value], False
                        continue
                    if kind == "hop":
                        hop_index, route_focus = value, True
                        continue
                    if kind == "menu":
                        menu_index = value
                        key = curses.KEY_RIGHT if menu == "Opções" else 10
                    elif kind == "key":
                        key = value
                    else:
                        continue
                else:
                    continue
            if filter_edit is not None:
                if key == 27:
                    query, selected = filter_edit
                    filter_edit = None
                elif key in (10, 13, curses.KEY_ENTER):
                    filter_edit = None
                elif key in (8, 127, curses.KEY_BACKSPACE):
                    query = query[:-1]
                elif key == curses.KEY_DC:
                    query = ""
                elif 32 <= key <= 126 and len(query) < 253:
                    query += chr(key)
                continue
            if key in (ord("m"), ord("?")) and width >= 48 and height >= 16:
                menu = ("Ajuda" if key == ord("?") else "Menu") if not menu else None
                menu_index = 0
                continue
            if key == 27 and not menu and width >= 48 and height >= 16:
                menu, menu_index = "Menu", 0
                continue
            if menu and key != ord("q"):
                if key == 27:
                    menu = None if menu == "Menu" else "Menu"
                    menu_index = 0
                elif key in (curses.KEY_UP, curses.KEY_DOWN) and menu != "Ajuda":
                    size = {"Menu": len(MENU_ITEMS), "Opções": 4, "Limpar lista": 2}[menu]
                    menu_index = (menu_index + (1 if key == curses.KEY_DOWN else -1)) % size
                elif key in (10, 13, curses.KEY_ENTER) and menu == "Menu":
                    menu = MENU_ITEMS[menu_index]
                    menu_index = 0
                    if menu == "Sair":
                        key = ord("q")
                elif key in (10, 13, curses.KEY_ENTER) and menu == "Limpar lista":
                    if menu_index == 1:
                        for monitor in monitors:
                            if monitor.pending is not None:
                                monitor.pending.cancel()
                        monitors.clear()
                        selected = 0
                        query = ""
                        target_state = 0
                        route_enabled = route_focus = False
                        message = "Lista limpa."
                        menu = None
                    else:
                        menu = "Menu"
                    menu_index = 0
                elif key in (curses.KEY_LEFT, curses.KEY_RIGHT) and menu == "Opções":
                    if menu_index == 0:
                        delta = 0.5 if key == curses.KEY_RIGHT else -0.5
                        interval = max(0.5, min(60, interval + delta))
                        next_probe = next_trace = 0
                    elif menu_index == 1:
                        names = tuple(THEMES)
                        delta = 1 if key == curses.KEY_RIGHT else -1
                        theme = names[(names.index(theme) + delta) % len(names)]
                        apply_theme(theme)
                    elif menu_index == 2:
                        graph_mode = "Quadrantes" if graph_mode == "Micro" else "Micro"
                    else:
                        theme_background = not theme_background
                        apply_theme(theme)
                if key != ord("q"):
                    continue
            if key == ord("q"):
                for monitor in monitors:
                    if monitor.pending is not None:
                        monitor.pending.cancel()
                return
            if key == ord("n") and width >= 24 and height >= 9:
                if lookup_pending is not None:
                    message = "A consulta DNS anterior ainda está em andamento."
                    continue
                lookup_query = ""
                if indices:
                    monitor = monitors[selected]
                    lookup_query = monitor.group or monitor.host
                lookup_output = []
                lookup_offset = 0
            elif key in (ord("f"), ord("/")):
                filter_edit = (query, selected)
                route_focus = False
                message = ""
            elif key == curses.KEY_DC:
                query = ""
            elif key == ord("v"):
                options = tuple(FAMILIES)
                versions = options[(options.index(versions) + 1) % len(options)]
                message = f"Novos alvos: {FAMILIES[versions]}"
            elif key == ord("r"):
                reverse = not reverse
                route_focus = False
            elif key == ord("s"):
                target_state = (target_state + 1) % len(TARGET_STATES)
                route_focus = False
            elif key == ord("p"):
                ping_enabled = not ping_enabled
                next_probe = 0
                if not ping_enabled:
                    for monitor in monitors:
                        if monitor.pending is not None and monitor.pending.cancel():
                            monitor.pending = None
            elif key == ord("t"):
                route_enabled = not route_enabled
                route_focus = route_enabled
            elif key == 9:
                route_focus = route_enabled and not route_focus
            elif key in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE):
                delta = {curses.KEY_UP: -1, curses.KEY_DOWN: 1,
                         curses.KEY_PPAGE: -page, curses.KEY_NPAGE: page}[key]
                if route_focus and hops:
                    hop_index = max(0, min(len(hops) - 1, hop_index + delta))
                elif not route_focus and indices:
                    selected = indices[max(0, min(len(indices) - 1, view_index + delta))]
            elif key == ord("d") and indices:
                route_focus = False
                removed = monitors.pop(selected)
                if removed.pending is not None:
                    removed.pending.cancel()
                selected = min(selected, max(0, len(monitors) - 1))
                message = ""
            elif key == ord("a") and height >= 3 and width >= 12:
                screen.move(height - 2, 0)
                screen.clrtoeol()
                screen.addstr("Alvo: ")
                curses.echo()
                curses.curs_set(1)
                screen.timeout(-1)
                try:
                    host = screen.getstr(height - 2, 6, min(253, width - 7)).decode(errors="replace").strip()
                except curses.error:
                    host = ""
                finally:
                    curses.noecho()
                    curses.curs_set(0)
                    screen.timeout(150)
                try:
                    existing = {(monitor.host, monitor.group) for monitor in monitors}
                    additions = [item for item in grouped_targets(host, versions) if item not in existing]
                    if not additions:
                        message = "Todos os alvos já estão na lista."
                    elif len(monitors) + len(additions) > MAX_TARGETS:
                        message = f"Limite de {MAX_TARGETS} alvos."
                    else:
                        route_focus = False
                        selected = len(monitors)
                        monitors.extend(Monitor(item, group=group) for item, group in additions)
                        next_probe = 0
                        message = f"{len(additions)} alvo(s) adicionado(s)."
                except ValueError as error:
                    message = str(error)



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("hosts", nargs="*", metavar="ALVO")
    parser.add_argument("-4", dest="ipv4", action="store_true", help="sondar IPv4")
    parser.add_argument("-6", dest="ipv6", action="store_true", help="sondar IPv6")
    parser.add_argument("-i", "--interval", type=float, default=1,
                        help="segundos entre ciclos (0,5 a 60)")
    args = parser.parse_intermixed_args()
    versions = tuple(v for v, enabled in ((4, args.ipv4), (6, args.ipv6)) if enabled)
    if not 0.5 <= args.interval <= 60:
        parser.error("o intervalo deve ficar entre 0,5 e 60 segundos")
    hosts = {}
    try:
        for value in args.hosts:
            hosts.update(dict.fromkeys(grouped_targets(value, versions)))
            if len(hosts) > MAX_TARGETS:
                raise ValueError(f"informe até {MAX_TARGETS} alvos")
    except ValueError as error:
        parser.error(str(error))
    try:
        curses.wrapper(dashboard, hosts, args.interval, versions)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
