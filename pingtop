TARGET = re.compile(r"[a-zA-Z0-9:][a-zA-Z0-9_.:%-]{0,252}")
LATENCY = re.compile(r"time[=<]([\d.]+)\s*ms")
MAX_TARGETS = 1024
MAX_WORKERS = 32
QUADRANTS = " ▘▝▀▖▌▞▛▗▚▐▜▄▙▟█"


def expand_target(value):
    if "/" in value:
        address, prefix = value.split("/", 1)
        if not re.fullmatch(r"[0-9]{1,2}", prefix):
            raise ValueError("Informe um CIDR IPv4 como 192.168.1.0/24.")
        network = ipaddress.IPv4Network(f"{address}/{prefix}", strict=False)
        usable = network.num_addresses - 2 if network.prefixlen < 31 else network.num_addresses
        if usable > MAX_TARGETS:
            raise ValueError(f"O CIDR deve ter até {MAX_TARGETS} hosts.")
        return [str(host) for host in network.hosts()]
    if re.fullmatch(r"[0-9.]+-[0-9.]+", value):
        first, last = (int(ipaddress.IPv4Address(part)) for part in value.split("-"))
        count = last - first + 1
        if not 1 <= count <= MAX_TARGETS:
            raise ValueError(f"A faixa deve estar em ordem crescente e ter até {MAX_TARGETS} IPs.")
        return [str(ipaddress.IPv4Address(number)) for number in range(first, last + 1)]
    if not TARGET.fullmatch(value):
        raise ValueError("Informe um IP, nome de host, faixa IPv4 ou CIDR válido.")
    return [value]


WINDOWS = os.name == "nt"
WINDOWS_RTT = re.compile(r"(?:[=<]\s*|(?<!\S))([0-9]+(?:[.,][0-9]+)?)\s*ms\b", re.IGNORECASE)


def windows_command(executable, *args, timeout):
    system = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32")
    return subprocess.run(
        [os.path.join(system, executable), *args],
        capture_output=True, text=True, encoding="oem", errors="replace",
        timeout=timeout, creationflags=subprocess.CREATE_NO_WINDOW,
    )


def parse_windows_ping(output, host, stamp):
    reply = re.compile(r"^\s*(?:Reply from|Resposta de)\s+(\S+?):\s", re.IGNORECASE)
    address = None
    candidates = [host, *re.findall(r"\[([^\]]+)\]", output)]
    candidates.extend(match[1] for line in output.splitlines() if (match := reply.match(line)))
    for candidate in candidates:
        try:
            address = str(ipaddress.ip_address(candidate))
        except ValueError:
            continue
        break
    for line in output.splitlines():
        if not reply.match(line):
            continue
        rtt = WINDOWS_RTT.search(line)
        if not rtt:
            continue
        size = re.search(r"bytes[=<]([0-9]+)", line, re.IGNORECASE)
        ttl = re.search(r"ttl[=<]([0-9]+)", line, re.IGNORECASE)
        details = (int(size[1]) if size else None, int(ttl[1]) if ttl else None)
        return "OK", float(rtt[1].replace(",", ".")), address, stamp, details
    unreachable = re.search(r"timed out|esgotad|unreachable|inacess[ií]vel", output, re.IGNORECASE)
    return ("TIMEOUT" if unreachable else "ERRO"), None, address, stamp, None


def parse_windows_route(output, stamp):
    hops = []
    for line in output.splitlines():
        row = re.match(r"^\s*(\d+)\s+((?:(?:<?\d+\s*ms|\*)\s+){3})(.*?)\s*$", line)
        if not row:
            continue
        address = None
        name = None
        tail = row[3].split()
        if tail:
            try:
                address = str(ipaddress.ip_address(tail[-1].strip("[]")))
                name = tail[0] if len(tail) > 1 else address
            except ValueError:
                pass
        values = re.findall(r"<?\d+\s*ms|\*", row[2])
        probes = tuple((None, None, None) if value == "*" else
                       (name, address, float(re.search(r"\d+", value)[0])) for value in values)
        hops.append((int(row[1]), probes, stamp))
    return hops


def load_targets(value, versions=()):
    if value.lower().startswith(("http://", "https://")):
        try:
            url = urlsplit(value)
            host = url.hostname
        except ValueError as error:
            raise ValueError("URL inválida.") from error
        if not host or not TARGET.fullmatch(host):
            raise ValueError("Informe uma URL HTTP(S) com hostname válido.")
        value = host

    targets = expand_target(value)
    if not versions:
        return targets

    addresses = []
    for target in targets:
        try:
            address = ipaddress.ip_address(target)
        except ValueError:
            try:
                answers = socket.getaddrinfo(target, None, type=socket.SOCK_STREAM)
            except OSError as error:
                raise ValueError(f"Não foi possível resolver {target}.") from error
            resolved = {}
            for family, _, _, _, sockaddr in answers:
                if family in (socket.AF_INET, socket.AF_INET6):
                    version = 4 if family == socket.AF_INET else 6
                    ip = sockaddr[0]
                    if version == 6 and sockaddr[3] and "%" not in ip:
                        ip = f"{ip}%{sockaddr[3]}"
                    resolved.setdefault(version, ip)
            addresses.extend(resolved[version] for version in versions if version in resolved)
        else:
            if address.version in versions:
                addresses.append(str(address))
    if not addresses:
        families = " ou ".join(f"IPv{version}" for version in versions)
        raise ValueError(f"{value}: sem endereço {families}.")
    return addresses


FAMILIES = {(): "Auto", (4,): "IPv4", (6,): "IPv6", (4, 6): "IPv4+IPv6"}


def grouped_targets(value, versions=()):
    if value.lower().startswith(("http://", "https://")):
        addresses = load_targets(value, versions or (4, 6))
        group = urlsplit(value).hostname
    else:
        addresses = load_targets(value, versions)
        numeric = ":" in value or "/" in value or re.fullmatch(r"[0-9.]+(?:-[0-9.]+)?", value)
        group = value.casefold() if versions and not numeric else None
    return [(address, group) for address in addresses]


def network_command(*args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout if result.returncode == 0 else ""


def windows_network():
    command = r"""
[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
$ErrorActionPreference = 'Stop'
@(Get-NetIPConfiguration -All | ForEach-Object {
    [pscustomobject]@{
        name = $_.InterfaceAlias
        state = [string]$_.NetAdapter.Status
        ipv4 = @($_.IPv4Address | Where-Object { $_.IPAddress } | ForEach-Object { "$($_.IPAddress)/$($_.PrefixLength)" })
        ipv6 = @($_.IPv6Address | Where-Object { $_.IPAddress } | ForEach-Object { "$($_.IPAddress)/$($_.PrefixLength)" })
        gateways = @($_.IPv4DefaultGateway.NextHop; $_.IPv6DefaultGateway.NextHop) | Where-Object { $_ }
        dns = @($_.DNSServer | ForEach-Object { $_.ServerAddresses })
    }
}) | ConvertTo-Json -Depth 5 -Compress
"""
    powershell = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"),
                              "System32", "WindowsPowerShell", "v1.0", "powershell.exe")
    try:
        result = subprocess.run(
            [powershell, "-NoProfile", "-NonInteractive", "-Command", command],
            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=8,
            creationflags=subprocess.CREATE_NO_WINDOW,
        )
    except (OSError, subprocess.TimeoutExpired):
        return [], ["Não foi possível ler a configuração de rede do Windows."]
    if result.returncode:
        return [], ["Não foi possível ler a configuração de rede do Windows."]
    adapters = json.loads(result.stdout or "[]")
    if isinstance(adapters, dict):
        adapters = [adapters]
    adapters.sort(key=lambda adapter: (not adapter.get("gateways"), adapter.get("state") != "Up"))
    details, summary = [], []
    for adapter in adapters:
        title = f"{adapter['name']} · {'ativa' if adapter['state'] == 'Up' else 'inativa'}"
        entries = []
        for key, label in (("ipv4", "IPv4"), ("ipv6", "IPv6"), ("gateways", "Gateway"), ("dns", "DNS")):
            values = adapter.get(key) or []
            if isinstance(values, str):
                values = [values]
            entries.extend(f"{label}  {value}" for value in dict.fromkeys(values) if value)
        details.append(title)
        details.extend(f"  {'└─' if index == len(entries) - 1 else '├─'} {line}"
                       for index, line in enumerate(entries))
        if not summary:
            compact = [title]
            for label in ("IPv4", "Gateway", "DNS", "IPv6"):
                line = next((entry for entry in entries if entry.startswith(label + " ")), None)
                if line:
                    compact.append(line)
            summary = compact
    return summary, details


def local_network():
    if WINDOWS:
        return windows_network()
    interfaces = json.loads(network_command("ip", "-j", "address", "show") or "[]")
    routes = [
        route for family in ("-4", "-6")
        for route in json.loads(network_command("ip", "-j", family, "route", "show", "default") or "[]")
    ]
    gateways = {}
    for route in sorted(routes, key=lambda route: route.get("metric", 0)):
        if route.get("dev"):
            gateways.setdefault(route["dev"], []).append(route.get("gateway", "direto"))

    dns = {}
    for line in network_command("resolvectl", "dns").splitlines():
        match = re.match(r"^(?:Global|Link \d+ \(([^)]+)\)):\s*(.*)$", line)
        if match and match[2]:
            dns[match[1]] = match[2].split()
    if not dns:
        try:
            resolver = Path("/etc/resolv.conf").read_text(errors="replace")
        except OSError:
            resolver = ""
        dns[None] = re.findall(r"^\s*nameserver\s+(\S+)", resolver, re.MULTILINE)

    interfaces = [interface for interface in interfaces if "LOOPBACK" not in interface.get("flags", ())]
    interfaces.sort(key=lambda interface: (interface["ifname"] not in gateways,
                                            "UP" not in interface.get("flags", ())))
    details = []
    summary = []
    for interface in interfaces:
        name = interface["ifname"]
        state = "ativa" if "UP" in interface.get("flags", ()) else "inativa"
        addresses = [
            (item["family"], f'{item["local"]}/{item["prefixlen"]}')
            for item in interface.get("addr_info", ()) if item.get("local")
        ]
        details.append(f"{name} · {state}")
        entries = [f"{'IPv4' if family == 'inet' else 'IPv6'}  {address}"
                   for family, address in addresses]
        entries += [f"Gateway  {gateway}" for gateway in gateways.get(name, ())]
        entries += [f"DNS  {server}" for server in dns.get(name, ())]
        for index, entry in enumerate(entries):
            branch = "└─" if index == len(entries) - 1 else "├─"
            details.append(f"  {branch} {entry}")
        if not summary:
            summary = [f"{name} · {state}"]
            for family in ("inet", "inet6"):
                address = next((address for kind, address in addresses if kind == family), None)
                if address:
                    summary.append(f"{'IPv4' if family == 'inet' else 'IPv6'}  {address}")
            if name in gateways:
                summary.insert(min(2, len(summary)), f"GW  {gateways[name][0]}")
            servers = dns.get(name) or dns.get(None)
            if servers:
                summary.insert(min(3, len(summary)), f"DNS  {servers[0]}")
    if dns.get(None):
        details += ["DNS do sistema", *[f"  {'└─' if index == len(dns[None]) - 1 else '├─'} {server}"
                                      for index, server in enumerate(dns[None])]]
        if not summary:
            summary = [f"DNS  {dns[None][0]}"]
    return summary, details


SNMP_CHOICES = {
    "operation": ("GET", "BULK", "WALK"),
    "version": ("2c", "3"),
    "level": ("noAuthNoPriv", "authNoPriv", "authPriv"),
    "auth": ("SHA", "SHA-256", "MD5"),
    "privacy": ("AES", "DES"),
}
SNMP_SECRETS = ("community", "auth_password", "privacy_password")


def snmp_fields(config):
    fields = [("host", "Host ou IP"), ("port", "Porta UDP"), ("version", "Versão"),
              ("operation", "Operação")]
    if config["version"] == "2c":
        fields.append(("community", "Community"))
    else:
        fields += [("username", "Usuário"), ("level", "Segurança")]
        if config["level"] != "noAuthNoPriv":
            fields += [("auth", "Autenticação"), ("auth_password", "Senha auth")]
        if config["level"] == "authPriv":
            fields += [("privacy", "Criptografia"), ("privacy_password", "Senha priv")]
    if config.get("operation") == "BULK":
        fields.append(("repetitions", "Repetições"))
    return fields + [("oid", "OID / raiz")]


def snmp_command(config):
    host = config["host"].strip()
    if not TARGET.fullmatch(host):
        raise ValueError("Informe um hostname ou IP válido.")
    if not config["port"].isdigit() or not 1 <= int(config["port"]) <= 65535:
        raise ValueError("Informe uma porta UDP entre 1 e 65535.")
    oid = config["oid"].strip()
    if not re.fullmatch(r"\.?[0-9]+(?:\.[0-9]+)*", oid):
        raise ValueError("Use um OID numérico, como .1.3.6.1.2.1.1.1.0.")
    version = config["version"]
    if version not in SNMP_CHOICES["version"]:
        raise ValueError("Escolha SNMP 2c ou 3.")
    operation = config.get("operation", "GET")
    tools = {"GET": "snmpget", "BULK": "snmpbulkget", "WALK": "snmpwalk"}
    if operation not in tools:
        raise ValueError("Escolha GET, BULK ou WALK.")
    command = [tools[operation], "-v", version, "-t", "2", "-r", "0", "-m", "", "-On"]
    if version == "2c":
        if not config["community"]:
            raise ValueError("Informe a community.")
        command += ["-c", config["community"]]
    else:
        if not config["username"] or config["level"] not in SNMP_CHOICES["level"]:
            raise ValueError("Informe o usuário e o nível de segurança.")
        command += ["-u", config["username"], "-l", config["level"]]
        for enabled, protocol, password, flag in (
            (config["level"] != "noAuthNoPriv", "auth", "auth_password", "a"),
            (config["level"] == "authPriv", "privacy", "privacy_password", "x"),
        ):
            if enabled:
                if config[protocol] not in SNMP_CHOICES[protocol] or len(config[password]) < 8:
                    raise ValueError("Escolha o protocolo e uma senha com pelo menos 8 caracteres.")
                command += [f"-{flag}", config[protocol], f"-{flag.upper()}", config[password]]
    if operation == "BULK":
        repetitions = config.get("repetitions", "10")
        if not repetitions.isdigit() or not 1 <= int(repetitions) <= 100:
            raise ValueError("Repetições BULK devem ficar entre 1 e 100.")
        command += ["-Cn0", f"-Cr{int(repetitions)}"]
    destination = f"udp6:[{host}]:{config['port']}" if ":" in host else f"udp:{host}:{config['port']}"
    return command + [destination, oid]


def snmp_output(output, config):
    for field in SNMP_SECRETS:
        if config[field]:
            output = output.replace(config[field], "********")
    return ["".join(char for char in line.expandtabs(4) if char.isprintable())
            for line in output.splitlines()]


def snmp_get(config, cancel=None, live=None):
    try:
        command = snmp_command(config)
    except ValueError as error:
        return [str(error)]
    started = time.monotonic()
    process_options = {"creationflags": subprocess.CREATE_NO_WINDOW} if WINDOWS else {}
    encoding = "oem" if WINDOWS else "utf-8"
    try:
        if config.get("operation") == "WALK":
            with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, **process_options) as process:
                while True:
                    if cancel is not None and cancel.is_set():
                        process.terminate()
                        try:
                            raw, _ = process.communicate(timeout=1)
                        except subprocess.TimeoutExpired:
                            process.kill()
                            raw, _ = process.communicate()
                        status = "WALK cancelado"
                        break
                    try:
                        raw, _ = process.communicate(timeout=0.2)
                    except subprocess.TimeoutExpired as partial:
                        if live is not None:
                            live[:] = snmp_output((partial.output or b"").decode(encoding, errors="replace"), config)
                        continue
                    status = "WALK concluído" if process.returncode == 0 else "WALK interrompido por erro"
                    break
                result = subprocess.CompletedProcess(command, process.returncode, raw.decode(encoding, errors="replace"), "")
        else:
            result = subprocess.run(command, capture_output=True, text=True, encoding=encoding, errors="replace", timeout=6, **process_options)
            status = "Resposta recebida" if result.returncode == 0 else "Consulta falhou"
    except FileNotFoundError:
        return [f"Instale o Net-SNMP e adicione {command[0]}.exe ao PATH." if WINDOWS else
                f"Instale o pacote snmp para disponibilizar {command[0]}."]
    except subprocess.TimeoutExpired:
        return ["Tempo limite da consulta SNMP excedido."]
    except OSError:
        return [f"Não foi possível executar {command[0]}."]
    output = "\n".join(part.strip() for part in (result.stdout, result.stderr) if part.strip())
    lines = snmp_output(output, config)
    return [f"{status} · {config['host']}:{config['port']} · {time.monotonic() - started:.2f} s", *lines]


def dns_lookup(host, server=""):
    if not TARGET.fullmatch(host):
        return ["Informe um hostname ou endereço IP válido."]
    if server and not TARGET.fullmatch(server):
        return ["Informe um servidor DNS válido."]
    args = ["-timeout=2", "-retry=1", host]
    if server:
        args.append(server)
    try:
        if WINDOWS:
            result = windows_command("nslookup.exe", *args, timeout=7)
        else:
            result = subprocess.run(
                ["nslookup", *args], capture_output=True, text=True, errors="replace", timeout=7,
            )
    except FileNotFoundError:
        return ["nslookup.exe indisponível." if WINDOWS else
                "Instale o nslookup (pacote dnsutils no Debian/Ubuntu)."]
    except subprocess.TimeoutExpired:
        return ["O servidor DNS não respondeu a tempo."]
    except OSError:
        return ["Não foi possível executar o nslookup."]
    output = "\n".join(part.strip() for part in (result.stdout, result.stderr) if part.strip())
    return ["".join(char for char in line.expandtabs(4) if char.isprintable())
            for line in output.splitlines()] or [f"Sem saída (código {result.returncode})."]


def probe(host):
    stamp = time.strftime("%H:%M:%S")
    try:
        if WINDOWS:
            result = windows_command("ping.exe", "-n", "1", "-w", "1000", host, timeout=3)
            return parse_windows_ping(result.stdout, host, stamp)
        result = subprocess.run(
            ["ping", "-n", "-c", "1", "-W", "1", "--", host],
            capture_output=True, text=True, timeout=3, env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        )
    except subprocess.TimeoutExpired:
        return "TIMEOUT", None, None, stamp, None
    except OSError:
        return "ERRO", None, None, stamp, None
    header = re.search(r"^PING [^\n]*?\(([^()]+)\)", result.stdout, re.MULTILINE)
    address = header[1] if header else None
    if address is None:
        try:
            address = str(ipaddress.ip_address(host))
        except ValueError:
            pass
    match = LATENCY.search(result.stdout)
    if result.returncode == 0 and match:
        reply = re.search(r"^(\d+) bytes from .*?\b(?:ttl|hlim)=(\d+)", result.stdout, re.MULTILINE)
        details = (int(reply[1]), int(reply[2])) if reply else None
        return "OK", float(match[1]), address, stamp, details
    return ("TIMEOUT" if result.returncode == 1 else "ERRO"), None, address, stamp, None


@dataclass
class Monitor:
    host: str
    status: str = "AGUARDE"
    history: deque = field(default_factory=lambda: deque(maxlen=512))
    sent: int = 0
    lost: int = 0
    pending: object = None

    log: deque = field(default_factory=lambda: deque(maxlen=60))
    address: str | None = None
    stamp: str = "—"

    route_probes: tuple = ()
    route_names: str = ""
    group: str | None = None

    def record(self, status, latency, address, stamp, details=None):
        self.status = status
        self.address = address or self.address
        self.stamp = stamp
        self.history.append(latency)
        self.log.append((stamp, latency, status, self.sent + 1, details))
        if status != "ERRO":
            self.sent += 1
            self.lost += status == "TIMEOUT"

    def update(self, pool, enabled):
        if self.pending is not None:
            if not self.pending.done():
                return
            self.record(*self.pending.result())
            self.pending = None
        if enabled:
            self.pending = pool.submit(probe, self.host)


def panel(put, y, x, height, width, title, color):
    put(y, x, "┌" + "─" * (width - 2) + "┐", color)
    title = "¹²³⁴"[int(title[0]) - 1] + title[1:] if title[:2] in ("1 ", "2 ", "3 ", "4 ") else title
    border_label(put, y, x + 2, title[:width - 6], color)
    for row in range(y + 1, y + height - 1):
        put(row, x, "│" + " " * (width - 2) + "│", color)
    put(y + height - 1, x, "└" + "─" * (width - 2) + "┘", color)


def border_label(put, y, x, title, color, *, bottom=False, hotkey=False, active=False):
    put(y, x, "┘" if bottom else "┐", color)
    if hotkey:
        put(y, x + 1, title[0], curses.color_pair(4) | curses.A_BOLD)
        put(y, x + 2, title[1:], color | curses.A_BOLD if active else 0)
    elif title and title[0] in "¹²³⁴":
        put(y, x + 1, title[0], color | curses.A_BOLD)
        put(y, x + 2, title[1:], curses.A_BOLD)
    else:
        put(y, x + 1, title, curses.A_BOLD)
    put(y, x + len(title) + 1, "└" if bottom else "┌", color)


def trace(host):
    stamp = time.strftime("%H:%M:%S")
    try:
        if WINDOWS:
            result = windows_command("tracert.exe", "-d", "-h", "24", "-w", "500", host, timeout=42)
            hops = parse_windows_route(result.stdout, stamp)
            return hops, "" if hops else "Tracert: nenhuma resposta de rota."
        result = subprocess.run(
            ["traceroute", "-I", "-q", "3", "-w", "0.5", "-m", "24", "--", host],
            capture_output=True, text=True, timeout=6, env={"LC_ALL": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
        )
    except FileNotFoundError:
        return [], "tracert.exe indisponível." if WINDOWS else "Instale o pacote traceroute."
    except (OSError, subprocess.TimeoutExpired):
        return [], "A sondagem da rota falhou."
    if result.returncode:
        detail = next((line.strip() for line in result.stderr.splitlines() if line.strip()), "")
        message = f"Tracert: {detail}" if detail else f"Tracert: falhou (código {result.returncode})."
        return [], message
    return parse_route(result.stdout, stamp), ""


def parse_route(output, stamp):
    hops = []
    tokens = re.compile(
        r"([^\s()]+)\s+\(([^()]+)\)|(\d+(?:\.\d+)?)\s+ms|\*|(!\S+)|(\S+)"
    )
    for line in output.splitlines():
        match = re.match(r"^\s*(\d+)\s+(.*)", line)
        if not match:
            continue
        name = address = None
        probes = []
        for token in tokens.finditer(match[2]):
            if token[1]:
                name, address = token[1], token[2]
            elif token[3]:
                probes.append((name, address, float(token[3])))
            elif token[0] == "*":
                probes.append((None, None, None))
            elif token[5]:
                try:
                    address = str(ipaddress.ip_address(token[5]))
                except ValueError:
                    continue
                name = address
        if probes:
            hops.append((int(match[1]), tuple(probes[:3]), stamp))
    return hops


def rtt_text(value):
    return f"{value:.2f}" if value is not None else "—"


HISTORY_GREYS = (255, 253, 251, 249, 247, 246, 245, 243)


def draw_history(put, y, width, height, monitor, red, dim, shaded=False):
    put(y + 1, 2, "Histórico de sondas"[:width], curses.A_BOLD)
    full = width >= 24
    seq_width = min(7, max(4, width - 20))
    if full:
        heading = f"{'HORA':8} {'SEQ':>{seq_width}} {'TTL':>3} {'RTT':>6}"
    elif width >= 20:
        heading = "HORA       RTT (ms)"
    else:
        heading = "HORA       RTT"
    put(y + 2, 2, heading[:width], dim)
    if height >= 8:
        put(y + 3, 2, "─" * width, dim | curses.A_DIM)
        start = 4
    else:
        start = 3
    capacity = min(len(monitor.log), height - start - 1)
    for row, entry in enumerate(reversed(monitor.log), y + start):
        if row >= y + height - 1:
            break
        stamp, latency, status, sequence, details = entry
        value = rtt_text(latency) if latency is not None else (
            "×" if status == "TIMEOUT" else "ERRO")
        if full:
            ttl = str(details[1]) if details and details[1] is not None else "—"
            seq = str(sequence)
            if len(seq) > seq_width:
                seq = "…" + seq[-(seq_width - 1):]
            line = f"{stamp} {seq:>{seq_width}} {ttl:>3} {value:>6}"
        else:
            line = f"{stamp}  {value}"
        age = row - y - start
        shade = age * (len(HISTORY_GREYS) - 1) // max(6, capacity - 1)
        style = curses.color_pair(15 + shade) if shaded else (
            curses.A_DIM if shade >= 3 else 0)
        if age == 0:
            style |= curses.A_BOLD
        put(row, 2, line[:width], style)
        if latency is None and len(line) <= width:
            put(row, 2 + len(line) - len(value), value, red | (curses.A_BOLD if age == 0 else 0))


def braille_cell(mask):
    dots = (1, 8, 2, 16, 4, 32, 64, 128)
    return chr(0x2800 + sum(dot for bit, dot in enumerate(dots) if mask & (1 << bit)))


def draw_graph(put, y, width, height, monitor, green, red, dim, graph_mode="Micro", shaded_history=False):
    # The summary floats inside the graph on wide terminals, as in btop's net panel.
    info_width = min(32, max(24 if width >= 66 else 18, width // 4))
    graph_x = info_width + 4
    graph_width = width - graph_x - 2
    inset = graph_width >= 39 and height >= 10
    inset_width = 18 if inset else 0
    cols = graph_width - inset_width
    body_rows = height - 4
    plot_rows = body_rows - body_rows % 2
    top = y + 2 + (body_rows - plot_rows) // 2
    half = plot_rows // 2
    history = list(monitor.history)[-2 * cols:]
    samples = [value for value in history if value is not None]
    latest = history[-1] if history else None
    minimum = min(samples, default=None)
    peak = max(samples, default=None)
    average = sum(samples) / len(samples) if samples else None

    draw_history(put, y, info_width, height, monitor, red, dim, shaded_history)
    for row in range(y + 1, y + height - 1):
        put(row, graph_x - 1, "│", dim | curses.A_DIM)
    heading = "Variação de RTT" if inset else f"RTT {rtt_text(latest)} ms"
    put(y + 1, graph_x, heading[:graph_width], curses.A_BOLD)

    # Two samples per cell, with four vertical microdots or two block pixels.
    # Preserve the two halves independently so each can use its own palette.
    spread = max((peak or 0) - (minimum or 0), 0.05)
    floor = max(0.0, (minimum or 0) - spread * 0.45)
    span = max(((peak or 0) - floor) * 1.08, 0.05)
    micro = graph_mode == "Micro"
    cell_depth = 4 if micro else 2
    pixel_height = half * cell_depth
    grid = [[0] * cols for _ in range(half)]
    start = 2 * cols - len(history)
    gaps = set()
    for index, value in enumerate(history, start):
        col, side = divmod(index, 2)
        if value is None:
            gaps.add(col)
            continue
        amplitude = max(1, round((value - floor) * pixel_height / span))
        for step in range(amplitude):
            row, subpixel = divmod(step, cell_depth)
            grid[row][col] |= 1 << (side + 2 * (cell_depth - 1 - subpixel))

    recent_col = (start + len(history) - 1) // 2
    used_cols = max(1, recent_col - start // 2 + 1)
    color = getattr(curses, "COLORS", 0) >= 256
    for row, cells in enumerate(grid):
        for col, mask in enumerate(cells):
            if not mask:
                continue
            age = min(3, (recent_col - col) * 4 // used_cols)
            emphasis = curses.A_BOLD if age == 0 else (curses.A_DIM if age >= 2 else 0)
            upper_style = curses.color_pair(6 + age) if color else green
            lower_style = curses.color_pair(10 + age) if color else dim
            # Stipple full cells so a flat run looks like pixels, not a solid rectangle.
            if not micro and mask == 15:
                mask = 9 if (row + col) % 2 == 0 else 6
            mirrored = sum(((mask >> (2 * level)) & 3) << (2 * (cell_depth - 1 - level))
                           for level in range(cell_depth))
            if micro:
                upper = braille_cell(mask)
                lower = braille_cell(mirrored)
            else:
                upper, lower = QUADRANTS[mask], QUADRANTS[mirrored]
            put(top + half - 1 - row, graph_x + col, upper, upper_style | emphasis)
            put(top + half + row, graph_x + col, lower, lower_style | emphasis)
    for col in gaps:
        if not grid[0][col]:
            put(top + half - 1, graph_x + col, "×", red)
    if not history:
        put(top + half - 1, graph_x, "Aguardando sondagem"[:cols], dim | curses.A_DIM)

    level = round((latest - floor) * 9 / span) if latest is not None else 0
    meter = "■" * level + "·" * (9 - level)
    if inset:
        axis_x = graph_x + cols + 1
        card_y = y + (height - 7) // 2
        panel(put, card_y, axis_x, 7, inset_width - 1, "RTT / ms", dim | curses.A_DIM)
        for offset, (label, value) in enumerate(
            (("Atual", latest), ("Mín", minimum), ("Méd", average), ("Máx", peak)), 1
        ):
            reading = "×" if offset == 1 and history and latest is None else rtt_text(value)
            put(card_y + offset, axis_x + 2, f"{label:<5} {reading:>7}"[:inset_width - 5],
                green | curses.A_BOLD if offset == 1 else 0)
        put(card_y + 5, axis_x + 2, "RTT " + meter, green)
    else:
        compact = f"{meter}  méd {rtt_text(average)}  máx {rtt_text(peak)}"
        put(y + height - 2, graph_x, compact[:graph_width], dim)


