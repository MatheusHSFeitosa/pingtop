#!/usr/bin/env python3
"""Monitor de latência ICMP para terminais Linux."""

import argparse
import curses
import ipaddress
import re
import subprocess
import time
from collections import deque
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field

TARGET = re.compile(r"[a-zA-Z0-9:][a-zA-Z0-9_.:%-]{0,252}")
LATENCY = re.compile(r"time[=<]([\d.]+)\s*ms")
MAX_TARGETS = 1024
MAX_WORKERS = 32


def expand_target(value):
    if "/" in value:
        address, prefix = value.split("/", 1)
        if not re.fullmatch(r"[0-9]{1,2}", prefix):
            raise ValueError("Informe um CIDR IPv4 como 192.168.1.0/24.")
        network = ipaddress.IPv4Network(f"{address}/{prefix}", strict=False)
        usable = network.num_addresses - 2 if network.prefixlen < 31 else network.num_addresses
        if usable > MAX_TARGETS:
            raise ValueError(f"O CIDR deve ter até {MAX_TARGETS} hosts.")
        return [str(host) for host in network.hosts()]
    if re.fullmatch(r"[0-9.]+-[0-9.]+", value):
        first, last = (int(ipaddress.IPv4Address(part)) for part in value.split("-"))
        count = last - first + 1
        if not 1 <= count <= MAX_TARGETS:
            raise ValueError(f"A faixa deve estar em ordem crescente e ter até {MAX_TARGETS} IPs.")
        return [str(ipaddress.IPv4Address(number)) for number in range(first, last + 1)]
    if not TARGET.fullmatch(value):
        raise ValueError("Informe um IP, nome de host, faixa IPv4 ou CIDR válido.")
    return [value]


def probe(host):
    stamp = time.strftime("%H:%M:%S")
    try:
        result = subprocess.run(
            ["ping", "-n", "-c", "1", "-W", "1", "--", host],
            capture_output=True, text=True, timeout=3, env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        )
    except subprocess.TimeoutExpired:
        return "TIMEOUT", None, None, stamp
    except OSError:
        return "ERRO", None, None, stamp
    header = re.search(r"^PING .*?\(([^)]+)\)", result.stdout, re.MULTILINE)
    address = header[1] if header else None
    match = LATENCY.search(result.stdout)
    if result.returncode == 0 and match:
        return "OK", float(match[1]), address, stamp
    return ("TIMEOUT" if result.returncode == 1 else "ERRO"), None, address, stamp


@dataclass
class Monitor:
    host: str
    status: str = "AGUARDE"
    history: deque = field(default_factory=lambda: deque(maxlen=60))
    sent: int = 0
    lost: int = 0
    pending: object = None

    address: str | None = None
    stamp: str = "—"

    def record(self, status, latency, address, stamp):
        self.status = status
        self.address = address or self.address
        self.stamp = stamp
        self.history.append(latency)
        if status != "ERRO":
            self.sent += 1
            self.lost += status == "TIMEOUT"

    def update(self, pool):
        if self.pending is not None:
            if not self.pending.done():
                return
            self.record(*self.pending.result())
        self.pending = pool.submit(probe, self.host)


def panel(put, y, x, height, width, title, color):
    put(y, x, "╭" + "─" * (width - 2) + "╮", color)
    put(y, x + 2, f" {title[:width - 6]} ", color | curses.A_BOLD)
    for row in range(y + 1, y + height - 1):
        put(row, x, "│" + " " * (width - 2) + "│", color)
    put(y + height - 1, x, "╰" + "─" * (width - 2) + "╯", color)


def trace(host):
    stamp = time.strftime("%H:%M:%S")
    try:
        result = subprocess.run(
            ["traceroute", "-I", "-n", "-q", "1", "-w", "0.5", "-m", "24", "--", host],
            capture_output=True, text=True, timeout=4, env={"LC_ALL": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
        )
    except FileNotFoundError:
        return [], "Instale o pacote traceroute."
    except (OSError, subprocess.TimeoutExpired):
        return [], "A sondagem da rota falhou."
    if result.returncode:
        return [], "Falha no traceroute ICMP. Confira as permissões."
    hops = []
    for line in result.stdout.splitlines():
        match = re.match(r"^\s*(\d+)\s+(\S+)(?:\s+([\d.]+)\s+ms)?", line)
        if match:
            ttl, address, rtt = match.groups()
            hops.append((int(ttl), address if address != "*" else None,
                         float(rtt) if rtt is not None else None, stamp))
    return hops, ""


def draw_graph(put, y, width, height, monitor, green, red, dim):
    # Unicode Braille gives two columns and four vertical positions per cell.
    cols = width - 4
    rows = height - 5
    history = list(monitor.history)[-2 * cols:]
    samples = [value for value in history if value is not None]
    peak = max(samples, default=0)
    average = f"{sum(samples) / len(samples):.2f} ms" if samples else "—"
    ip = monitor.address
    if ip is None:
        try:
            ip = str(ipaddress.ip_address(monitor.host))
        except ValueError:
            ip = "—"
    put(y + 1, 2, f"IP {ip}"[:cols], curses.A_BOLD)
    put(y + 2, 2, f"Sonda {monitor.stamp}  Média {average}"[:cols], dim)
    scale = f"0 ─ Pico {peak:.2f} ms" if samples else "Sem RTT disponível"
    put(y + height - 2, 2, f"{scale} · {len(history)} amostras"[:cols], dim)
    grid = [[0] * cols for _ in range(rows)]
    dots = ((1, 2, 4, 64), (8, 16, 32, 128))
    gaps = set()
    for index, value in enumerate(history, 2 * cols - len(history)):
        col, side = divmod(index, 2)
        if value is None:
            gaps.add(col)
            continue
        level = round(value / (peak or 1) * (4 * rows - 1))
        row, offset = divmod(4 * rows - 1 - level, 4)
        grid[row][col] |= dots[side][offset]
    for row, cells in enumerate(grid):
        put(y + 3 + row, 2, "".join(chr(0x2800 + cell) if cell else " " for cell in cells), green)
    for col in gaps:
        if not grid[-1][col]:
            put(y + height - 3, 2 + col, "×", red)


def draw_dashboard(put, height, width, monitors, selected, interval, message, menu,
                   hops, hop_index, route_focus, route_message):
    cyan, green, yellow, red, purple = (curses.color_pair(n) for n in range(1, 6))
    bold = curses.A_BOLD
    if width < 48 or height < 16:
        put(0, 0, "PINGTOP", cyan | bold)
        put(1, 0, "Amplie o terminal para pelo menos 48×16.")
        return 1

    width -= 1
    panel(put, 0, 0, 3, width, "PINGTOP / ICMP", cyan)
    put(1, 2, f"{len(monitors)} alvos  ·  {interval:g}s", bold)
    wide = width >= 95 and height >= 20
    left = width // 2 if wide else width
    right = width - left if wide else width
    split = (height - 6) // 2 if wide else 0
    chart_y = 3 + split
    chart_height = height - chart_y - 3 if wide else max(6, (height - 6) // 2)
    table_x = left if wide else 0
    route_y = chart_y if wide else chart_y + chart_height
    table_y = route_y if route_focus and not wide else (3 if wide else route_y)
    table_height = split if wide else height - table_y - 3
    route_height = chart_height if wide else table_height
    target = monitors[selected] if monitors else None
    current_hop = hops[hop_index][1] if hops else None
    chart = current_hop if route_focus and current_hop else target

    if wide:
        panel(put, 3, 0, split, left, "1 Alvo selecionado", purple)
        if target:
            put(4, 2, target.host[:left - 4], bold)
            put(5, 2, f"Estado {target.status}  ·  Enviados {target.sent}  ·  Perdidos {target.lost}"[:left - 4])
            last = target.history[-1] if target.history else None
            rtt = f"{last:.2f} ms" if last is not None else "—"
            put(6, 2, f"Último RTT {rtt}  ·  Ping {target.stamp}"[:left - 4])
    title = f"3 Gráfico / salto {hops[hop_index][0]}" if route_focus and current_hop else "3 Gráfico / alvo"
    panel(put, chart_y, 0, chart_height, left, title, purple)
    if chart:
        draw_graph(put, chart_y, left, chart_height, chart, green, red, purple)
    else:
        put(chart_y + 1, 2, "Pressione a para adicionar um alvo.", yellow)

    if wide or not route_focus:
        panel(put, table_y, table_x, table_height, right, "2 Alvos monitorados",
              cyan | (0 if route_focus else bold))
        name_width = right - 31
        put(table_y + 1, table_x + 2,
            f"{'ALVO':<{name_width}} {'ESTADO':<8} {'RTT':>9} {'PERDA':>6}", bold)
        visible = table_height - 3
        start = max(0, selected - visible + 1)
        for index, monitor in enumerate(monitors[start:start + visible], start):
            style = {"OK": green, "AGUARDE": yellow}.get(monitor.status, red)
            if index == selected:
                style |= curses.A_REVERSE
            last = monitor.history[-1] if monitor.history else None
            latency = f"{last:.2f} ms" if last is not None else "—"
            loss = f"{monitor.lost / monitor.sent:.0%}" if monitor.sent else "—"
            put(table_y + 2 + index - start, table_x + 2,
                f"{monitor.host[:name_width]:<{name_width}} {monitor.status:<8} {latency:>9} {loss:>6}", style)

    if wide or route_focus:
        panel(put, route_y, table_x, route_height, right, "4 Tracert / ICMP", red)
        name_width = right - 29
        put(route_y + 1, table_x + 2,
            f"{'#':>2} {'SALTO':<{name_width}} {'RTT ms':>7} {'Média':>7} {'Perda':>5}", bold)
        visible_hops = route_height - 3
        start = max(0, hop_index - visible_hops + 1)
        for index, (ttl, hop) in enumerate(hops[start:start + visible_hops], start):
            samples = [value for value in hop.history if value is not None]
            last = hop.history[-1]
            rtt = f"{last:.2f}" if last is not None else "—"
            average = f"{sum(samples) / len(samples):.2f}" if samples else "—"
            loss = f"{hop.lost / hop.sent:.0%}"
            style = green if last is not None else yellow
            if route_focus and index == hop_index:
                style |= curses.A_REVERSE
            put(route_y + 2 + index - start, table_x + 2,
                f"{ttl:2} {hop.host[:name_width]:<{name_width}} {rtt:>7} {average:>7} {loss:>5}", style)
        if not hops or route_message:
            put(route_y + route_height - 2, table_x + 2,
                (route_message or "t Iniciar rota")[:right - 4], yellow)

    put(height - 2, 2, message, yellow)
    put(height - 1, 1, "t Rota  Tab Foco  a Adic.  d Rem.  m Menu  q Sair", cyan | bold)
    if menu:
        menu_width = min(56, width - 4)
        y, x = (height - 9) // 2, (width - menu_width) // 2
        panel(put, y, x, 9, menu_width, "PINGTOP / Menu", red)
        for row, line in enumerate((
            "t      Iniciar ou parar Tracert",
            "Tab    Alternar foco entre alvos e saltos",
            "↑ ↓    Selecionar e atualizar gráfico",
            "Pg↑ ↓  Navegar por página",
            "a / d  Adicionar / remover alvo",
            "q      Sair", "Esc    Fechar menu",
        ), y + 1):
            put(row, x + 2, line, bold if row == y + 1 else 0)
    return max(1, (route_height if route_focus else table_height) - 3)


def dashboard(screen, hosts, interval):
    curses.curs_set(0)
    screen.keypad(True)
    screen.timeout(150)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        for index, color in enumerate((curses.COLOR_CYAN, curses.COLOR_GREEN,
                                       curses.COLOR_YELLOW, curses.COLOR_RED,
                                       curses.COLOR_MAGENTA), 1):
            curses.init_pair(index, color, -1)

    monitors = [Monitor(host) for host in hosts]
    selected = 0
    next_probe = 0
    message = ""
    menu = False
    route_enabled = route_focus = False
    route_target = route_pending = None
    route_message = ""
    next_trace = 0
    hops = []
    hop_index = 0
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool, ThreadPoolExecutor(max_workers=1) as routes:
        while True:
            now = time.monotonic()
            if now >= next_probe:
                for monitor in monitors:
                    monitor.update(pool)
                next_probe = now + interval

            target = monitors[selected] if monitors and route_enabled else None
            if target is not route_target:
                route_target = target
                hops = []
                hop_index = 0
                next_trace = 0
                route_message = "Sondando rota…" if target else ""
            if route_pending and route_pending[1].done():
                traced, future = route_pending
                route_pending = None
                if traced is target:
                    results, route_message = future.result()
                    previous = dict(hops)
                    if results:
                        hops = []
                        for ttl, address, rtt, stamp in results:
                            old = previous.get(ttl)
                            label = address or (old.host if old else "*")
                            hop = old if old and old.host == label else Monitor(label)
                            hop.record("OK" if rtt is not None else "TIMEOUT", rtt, address, stamp)
                            hops.append((ttl, hop))
                        hop_index = min(hop_index, len(hops) - 1)
                    next_trace = now + max(1, interval)
            if target and route_pending is None and now >= next_trace:
                route_pending = (target, routes.submit(trace, target.address or target.host))

            screen.erase()
            height, width = screen.getmaxyx()

            def put(y, x, value, style=0):
                if 0 <= y < height and 0 <= x < width - 1:
                    screen.addnstr(y, x, value, width - x - 1, style)

            page = draw_dashboard(put, height, width, monitors, selected, interval, message, menu,
                                  hops, hop_index, route_focus, route_message)
            try:
                key = screen.getch()
            except KeyboardInterrupt:
                key = ord("q")
            if key in (ord("m"), ord("?")):
                menu = not menu and width >= 48 and height >= 16
                continue
            if menu and (width < 48 or height < 16):
                menu = False
            if menu:
                if key == 27:
                    menu = False
                    continue
                if key not in (ord("a"), ord("d"), ord("q")):
                    continue
                menu = False
            if key in (ord("q"), 27):
                for monitor in monitors:
                    if monitor.pending is not None:
                        monitor.pending.cancel()
                return
            if key == ord("t"):
                route_enabled = not route_enabled
                route_focus = route_enabled
            elif key == 9:
                route_focus = route_enabled and not route_focus
            elif key in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE):
                delta = {curses.KEY_UP: -1, curses.KEY_DOWN: 1,
                         curses.KEY_PPAGE: -page, curses.KEY_NPAGE: page}[key]
                if route_focus and hops:
                    hop_index = max(0, min(len(hops) - 1, hop_index + delta))
                elif not route_focus and monitors:
                    selected = max(0, min(len(monitors) - 1, selected + delta))
            elif key == ord("d") and monitors:
                route_focus = False
                removed = monitors.pop(selected)
                if removed.pending is not None:
                    removed.pending.cancel()
                selected = min(selected, max(0, len(monitors) - 1))
                message = ""
            elif key == ord("a") and height >= 3 and width >= 12:
                screen.move(height - 2, 0)
                screen.clrtoeol()
                screen.addstr("Alvo: ")
                curses.echo()
                curses.curs_set(1)
                screen.timeout(-1)
                try:
                    host = screen.getstr(height - 2, 6, min(253, width - 7)).decode(errors="replace").strip()
                except curses.error:
                    host = ""
                finally:
                    curses.noecho()
                    curses.curs_set(0)
                    screen.timeout(150)
                try:
                    existing = {monitor.host for monitor in monitors}
                    additions = [item for item in expand_target(host) if item not in existing]
                    if not additions:
                        message = "Todos os alvos já estão na lista."
                    elif len(monitors) + len(additions) > MAX_TARGETS:
                        message = f"Limite de {MAX_TARGETS} alvos."
                    else:
                        route_focus = False
                        selected = len(monitors)
                        monitors.extend(Monitor(item) for item in additions)
                        next_probe = 0
                        message = f"{len(additions)} alvo(s) adicionado(s)."
                except ValueError as error:
                    message = str(error)



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("hosts", nargs="*", metavar="ALVO")
    parser.add_argument("-i", "--interval", type=float, default=1,
                        help="segundos entre ciclos (0,5 a 60)")
    args = parser.parse_args()
    if not 0.5 <= args.interval <= 60:
        parser.error("o intervalo deve ficar entre 0,5 e 60 segundos")
    hosts = {}
    try:
        for value in args.hosts:
            hosts.update(dict.fromkeys(expand_target(value)))
            if len(hosts) > MAX_TARGETS:
                raise ValueError(f"informe até {MAX_TARGETS} alvos")
    except ValueError as error:
        parser.error(str(error))
    try:
        curses.wrapper(dashboard, hosts, args.interval)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
